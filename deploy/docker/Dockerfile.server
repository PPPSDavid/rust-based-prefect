# IronFlow API server image (Tier A / B5 compose).
#
# Build from repo root:
#   docker build -f deploy/docker/Dockerfile.server -t ironflow-server:local .
#
# Local wheel:
#   python -m build --wheel --outdir dist/wheels --directory python-shim
#   docker build -f deploy/docker/Dockerfile.server \
#     --build-arg INSTALL_MODE=local -t ironflow-server:local .

ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim AS runtime

ARG IRONFLOW_VERSION=0.3.0
ARG INSTALL_MODE=pypi

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ironflow

RUN pip install --no-cache-dir \
    "fastapi>=0.115,<1" \
    "uvicorn[standard]>=0.30,<1" \
    "psycopg[binary]>=3.1,<4"

COPY dist/wheels/ /tmp/wheels/
RUN if [ "$INSTALL_MODE" = "local" ]; then \
      WHEEL="$(ls /tmp/wheels/ironflow_prefect_compat-*.whl | head -n 1)"; \
      pip install --no-cache-dir "$WHEEL"; \
    else \
      pip install --no-cache-dir "ironflow-prefect-compat[postgres]==${IRONFLOW_VERSION}"; \
    fi \
    && rm -rf /tmp/wheels

ENV IRONFLOW_HISTORY_PATH=/data/ironflow_history.jsonl \
    IRONFLOW_ENABLE_LOCAL_WORKER=1 \
    IRONFLOW_ENABLE_SCHEDULER=1 \
    PYTHONUNBUFFERED=1

VOLUME ["/data"]
EXPOSE 8000

COPY deploy/docker/entrypoint-server.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=3)"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "prefect_compat.server:app", "--host", "0.0.0.0", "--port", "8000"]
